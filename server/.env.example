# Server Configuration
PORT=5001
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas cluster URI)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/reclothing?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/reclothing?retryWrites=true&w=majority

# JWT Secret Key for token signing and cookie verification
JWT_SECRET=reclothing_campus_super_secure_jwt_secret_key_2026_xyz

# Frontend Application URL (for CORS and cookie authorization)
CLIENT_URL=https://your-reclothing-client.vercel.app
